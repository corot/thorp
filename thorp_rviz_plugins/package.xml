<?xml version="1.0"?>
<package format="2">
  <name>thorp_rviz_plugins</name>
  <version>0.0.1</version>

  <description>RViz plugins for Thorp navigation</description>

  <maintainer email="renan.salles@rapyuta-robotics.com">Renan</maintainer>
  <license>Commercial</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>libogre-dev</build_depend>
  <build_export_depend>libogre-dev</build_export_depend>
  <depend>libogre</depend>


  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>pluginlib</depend>
  <depend>roscpp</depend>>
  <depend>jsk_rviz_plugins</depend>
  <depend>rviz</depend>

  <export>
    <rviz plugin="${prefix}/plugins.xml"/>
  </export>

</package>
