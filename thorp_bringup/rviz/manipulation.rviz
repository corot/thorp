Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /MotionPlanning1
  - Class: rviz_common/Views
    Name: Views
  - Class: thorp_rviz_plugins/UserCommands
    Name: User Commands
    Topic: /user_command
    Buttons:
      - Name: start
        Icon: package://thorp_bringup/rviz/icons/start.png
        Command: start
      - Name: stop
        Icon: package://thorp_bringup/rviz/icons/stop.png
        Command: stop
      - Name: reset
        Icon: package://thorp_bringup/rviz/icons/reset.png
        Command: reset
      - Name: exit
        Icon: package://thorp_bringup/rviz/icons/exit.png
        Command: exit
      - Name: clear gripper
        Icon: package://thorp_bringup/rviz/icons/clear.png
        Command: clear
      - Name: fold arm
        Icon: package://thorp_bringup/rviz/icons/fold.png
        Command: fold
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Velocity_Scaling_Factor: 1.0  # RViz can't read joint_limits.yaml defaults, and starts at 0.1 otherwise
      Acceleration_Scaling_Factor: 1.0
      Planned Path:
        Loop Animation: false
        State Display Time: 0.05 s
        Trajectory Topic: display_planned_path
      Planning Scene Topic: monitored_planning_scene
      Robot Description: robot_description
      Scene Geometry:
        Scene Alpha: 1
      Scene Robot:
        Robot Alpha: 0.5
      Value: true
    - Class: rviz_default_plugins/InteractiveMarkers
      Enabled: true
      Interactive Markers Namespace: /move_objects
      Name: Objects Interaction
      Show Axes: false
      Show Descriptions: false
      Show Visual Aids: false
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF
      Value: false
    - Class: rviz_2d_overlay_plugins/TextOverlay
      Enabled: true
      Name: User Command
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rviz/user_command
      Value: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_footprint
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.5
      Focal Point:
        X: 0.3
        Y: 0.0
        Z: 0.4
      Name: Current View
      Pitch: 0.6
      Target Frame: base_footprint
      Yaw: 3.6
Window Geometry:
  Height: 975
  Width: 1400
