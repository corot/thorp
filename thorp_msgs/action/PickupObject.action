# goal definition

string object_name
string support_surf
float32 max_effort   # maximum effort exerted by the gripper to consider the object as grasped
float32 tightening   # additional gripper closing to tighten grasped objects

---

# result definition

ThorpError error

---

# feedback
string stage  # "planning", or the task stage being executed, e.g. "approach object"
