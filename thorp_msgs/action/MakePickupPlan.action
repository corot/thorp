# Group objects into picking locations and sort them to make a picking plan
# If no pickup poses are provided, we create 4 on the surface sides

# goal definition

geometry_msgs/PoseStamped robot_pose
geometry_msgs/PoseStamped[] pickup_poses
moveit_msgs/CollisionObject[] objects
moveit_msgs/CollisionObject surface

string planning_frame
float32 approach_dist   # close enough to properly detect tabletop objects but not for picking
float32 pickup_dist     # ideal pickup distance to the table, as close as possible without risk
float32 detach_dist     # far enough to safely navigate around the table to other picking poses
float32 max_arm_reach   # maximum distance reachable by the arm from a picking location;
                        # should include some tolerance to cope with navigation imprecision

---

# result definition

thorp_msgs/PickupPlan pickup_plan

---

# feedback
