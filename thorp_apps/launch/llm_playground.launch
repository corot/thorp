<!--
  A fixed, repeatable scene for exercising capabilities one at a time, through bt_server's
  RunSubtree action: an LLM agent driving the robot, or the capability test suite.

  Deliberately a tabletop bench rather than a house. A lack_table sits at (0.45, 0) with five
  cubes at known poses on it, named 'cube 1' to 'cube 5', and the robot starts half a meter
  short of it. Same table, same cubes, same names, same poses, every run.

  The robot starts back from the table rather than at it, because the capabilities that work
  at a table say so themselves: capabilities.yaml gives them a setup chain of detect_table,
  table_pickup_poses and attach_to_table, so they drive in on real detected values instead of
  on a pose someone typed. /gazebo/reset_world puts the robot back here between tests, so the
  approach capabilities always have an approach to make and the manipulation ones always
  arrive the same way.

  Navigation runs here too, but only as much as approaching a table needs: an empty map whose
  only obstacle is the table. The capabilities that want somewhere to GO (explore_house, the
  coverage planners, follow_waypoints) still want a house, a real map and a destination. That
  is a second rig with different properties: reachable, but not repeatable the way this is.

  Launch it with `roslaunch thorp_apps llm_playground.launch simulator:=gazebo`, then run the
  capability suite from thorp_bt_cpp with the stack list navigation,manipulation,perception.
 -->

<launch>
  <arg name="app_name"       value="llm_playground"/>
  <arg name="simulator"      default="gazebo"/>  <!-- none | gazebo -->
  <arg name="localization"   default="gazebo" if="$(eval simulator == 'gazebo')"/>
  <arg name="localization"   default="amcl" unless="$(eval simulator == 'gazebo')"/>

  <!-- Half a meter back from the table, facing it. Not arbitrary: the capabilities that work
       AT the table say so in capabilities.yaml and drive in themselves (detect_table ->
       table_pickup_poses -> attach_to_table), so the start pose is the one the approach
       capabilities need, and /gazebo/reset_world returns the robot here between tests. Any
       further back and detect_table stops seeing a 55 cm table. -->
  <arg name="initial_pose_x" default="-0.5"/>
  <arg name="initial_pose_y" default="0.0"/>
  <arg name="initial_pose_a" default="0.0"/>
  <arg name="executive"      default="llm"/>
  <arg name="viz_executive"  default="false"/>
  <arg name="start_delay"    default="0.0"/>
  <arg name="record_video"   default="false"/>

  <arg name="object_type"    default="fixed"/>  <!-- cubes | fixed | random -->

  <!--  ******* Components common for all apps ********  -->
  <include file="$(find thorp_apps)/launch/includes/apps_common.launch.xml">
    <arg name="app_name"       value="$(arg app_name)"/>
    <arg name="simulator"      value="$(arg simulator)"/>
    <arg name="initial_pose_x" value="$(arg initial_pose_x)"/>
    <arg name="initial_pose_y" value="$(arg initial_pose_y)"/>
    <arg name="initial_pose_a" value="$(arg initial_pose_a)"/>
    <arg name="executive"      value="$(arg executive)"/>
    <arg name="viz_executive"  value="$(arg viz_executive)"/>
    <arg name="start_delay"    value="$(arg start_delay)"/>
    <arg name="record_video"   value="$(arg record_video)"/>
  </include>

  <!--  ***************** Navigation ******************  -->
  <include file="$(find thorp_navigation)/launch/navigation.launch">
    <arg name="smooth_velocity" value="$(eval simulator == 'none')"/>
    <arg name="save_robot_pose" value="$(eval simulator == 'none')"/>
    <arg name="map_name"        value="playground"/>
    <arg name="localization"    value="$(arg localization)"/>
    <arg name="initial_pose_x"  value="$(arg initial_pose_x)"/>
    <arg name="initial_pose_y"  value="$(arg initial_pose_y)"/>
    <arg name="initial_pose_a"  value="$(arg initial_pose_a)"/>
  </include>

  <group if="$(eval simulator != 'none')">
    <!-- The table and its objects, at the poses hardcoded in the spawner -->
    <node pkg="thorp_simulation" type="spawn_gazebo_models.py" name="objects_spawner" output="screen"
          args="playground_$(arg object_type)"/>

    <!-- A static cat to the robot's left, plus the rocket the cannon needs, for hunt_cat -->
    <node pkg="thorp_simulation" type="spawn_gazebo_models.py" name="cat_spawner" output="screen"
          args="playground_cat"/>

    <node pkg="thorp_simulation" type="cats_controller.py" name="cats_controller" output="screen" respawn="true">
      <param name="target_models" value="cat_orange"/>
      <param name="prowling_step" value="0.0"/>  <!-- stopped; the controller is only to move the fallen cat away -->

      <param name="outside_x" value="5.0"/>
      <param name="outside_y" value="5.0"/>
    </node>
  </group>

  <!--  ********* Perception and manipulation *********  -->
  <!-- RAIL for the tabletop capabilities, COB for hunt_cat: only COB publishes tracked_objects
       and target_object_predicted_pose. COB costs an SSD-MobileNet per kinect frame; drop it
       first if manipulation timings suffer. -->
  <include file="$(find thorp_perception)/launch/perception.launch">
    <arg name="pipeline" value="RAIL COB"/>
    <arg name="target_objects" value="[cat, dog, horse]"/>  <!-- required by cob_object_tracking -->
  </include>

  <include file="$(find thorp_manipulation)/launch/manipulation.launch">
    <arg name="simulation" value="$(eval simulator != 'none')"/>
    <arg name="debug" value="false"/>
  </include>

  <node pkg="rviz" type="rviz" name="rviz" output="screen" respawn="true"
        args="-d $(find thorp_bringup)/rviz/bt_server.rviz"/>
</launch>
