<?xml version="1.0"?>
<robot name="thorp_gazebo" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Gazebo Harmonic configuration: sensors, systems and surface properties.
       Gazebo topics are named as the ROS topics they are bridged to by thorp_simulation. -->

  <!-- Kobuki base: diff drive, odometry, joint states and IMU, on the same topics as the kobuki_gazebo plugin -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.230</wheel_separation>
      <wheel_radius>0.035</wheel_radius>
      <topic>/mobile_base/commands/velocity</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publisher_frequency>50</odom_publisher_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

  <gazebo reference="gyro_link">
    <sensor type="imu" name="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <topic>/mobile_base/sensors/imu_data</topic>
      <gz_frame_id>gyro_link</gz_frame_id>
    </sensor>
  </gazebo>

  <xacro:macro name="kobuki_surface" params="link mu">
    <gazebo reference="${link}">
      <mu1>${mu}</mu1>
      <mu2>${mu}</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>1.0</maxVel>
    </gazebo>
  </xacro:macro>

  <xacro:kobuki_surface link="wheel_left_link" mu="10.0"/>
  <xacro:kobuki_surface link="wheel_right_link" mu="10.0"/>
  <xacro:kobuki_surface link="caster_front_link" mu="0.1"/>
  <xacro:kobuki_surface link="caster_back_link" mu="0.1"/>
  <gazebo reference="base_link">
    <mu1>0.3</mu1>
    <mu2>0.3</mu2>
  </gazebo>

  <!-- Simulated Microsoft Kinect / ASUS Xtion PRO Live macros; included on their respective xacro files.
       Gazebo cameras look along the x axis of the link they are attached to, so we attach them to the camera
       link, that matches the RGB frame, and stamp their images with the RGB optical frame -->
  <xacro:macro name="thorp_sim_3dsensor" params="name">
    <gazebo reference="${name}_link">
      <sensor type="rgbd_camera" name="${name}">
        <always_on>true</always_on>
        <update_rate>10.0</update_rate>
        <topic>/${name}</topic>
        <gz_frame_id>${name}_rgb_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>${58.0*M_PI/180.0}</horizontal_fov>  <!-- kinect: 57, xtion: 58 -->
          <image>
            <format>R8G8B8</format>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>8.0</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.35</near>  <!-- actual value is 0.45, hacked to detect upper shelves -->
              <far>6.0</far>
            </clip>
          </depth_camera>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- Single or multi-ray range sensor; ros_gz_bridge converts its laser scans into range messages,
       with the closest reading and the rays spread as field of view -->
  <xacro:macro name="thorp_sim_ranger" params="name link topic h_samples h_fov v_samples v_min v_max
                                               min_range max_range noise visualize">
    <gazebo reference="${link}">
      <sensor type="gpu_lidar" name="${name}">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <visualize>${visualize}</visualize>
        <topic>${topic}</topic>
        <gz_frame_id>${link}</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>${h_samples}</samples>
              <resolution>1</resolution>
              <min_angle>${-h_fov/2}</min_angle>
              <max_angle>${+h_fov/2}</max_angle>
            </horizontal>
            <vertical>
              <samples>${v_samples}</samples>
              <resolution>1</resolution>
              <min_angle>${v_min}</min_angle>
              <max_angle>${v_max}</max_angle>
            </vertical>
          </scan>
          <range>
            <min>${min_range}</min>
            <max>${max_range}</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>${noise}</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- LV-MaxSonar-EZ2 ultrasound sensors
       Emulate the wide fov of the EZ2 with a 7x7 rays lidar, taking the closest reading.
       Specifications are fov: 0.6 rad and max. range: 6 m, but we clipped that radically in the real robot to
       0.3 and 0.8 respectively to avoid polluting the costmaps, while still providing safety against collisions
   -->
  <xacro:macro name="LV_MaxSonar_EZ2_sim" params="name topic:=''">
    <!-- Vertical fov is almost parallel to the ground to avoid detecting it -->
    <xacro:thorp_sim_ranger name="s_${name}" link="s_${name}_link"
                            topic="/mobile_base/sensors/sonars/${topic if topic else name}"
                            h_samples="7" h_fov="0.3" v_samples="7" v_min="-0.10" v_max="+0.20"
                            min_range="0.1" max_range="0.8" noise="0.0" visualize="false"/>
  </xacro:macro>

  <xacro:LV_MaxSonar_EZ2_sim name="m90"/>
  <xacro:LV_MaxSonar_EZ2_sim name="m72"/>
  <xacro:LV_MaxSonar_EZ2_sim name="m54"/>
  <xacro:LV_MaxSonar_EZ2_sim name="m36"/>
  <xacro:LV_MaxSonar_EZ2_sim name="m18"/>
  <xacro:LV_MaxSonar_EZ2_sim name="0" topic="p0"/>  <!-- ROS 2 names can't start with a digit -->
  <xacro:LV_MaxSonar_EZ2_sim name="p18"/>
  <xacro:LV_MaxSonar_EZ2_sim name="p36"/>
  <xacro:LV_MaxSonar_EZ2_sim name="p54"/>
  <xacro:LV_MaxSonar_EZ2_sim name="p72"/>
  <xacro:LV_MaxSonar_EZ2_sim name="p90"/>

  <!-- Sharp GP2Y0A21 IR sensors
       Its fov is narrow enough (0.08 rad) to be simulated with a single row of three rays
   -->
  <xacro:macro name="Sharp_GP2Y0A21_IR_sim" params="name">
    <xacro:thorp_sim_ranger name="ir_${name}" link="ir_${name}_link" topic="/mobile_base/sensors/infrared/${name}"
                            h_samples="3" h_fov="0.08" v_samples="1" v_min="0.0" v_max="0.0"
                            min_range="0.01" max_range="0.90" noise="0.01" visualize="false"/>
  </xacro:macro>

  <xacro:Sharp_GP2Y0A21_IR_sim name="arm"/>
  <xacro:Sharp_GP2Y0A21_IR_sim name="l155"/>
  <xacro:Sharp_GP2Y0A21_IR_sim name="l180"/>
  <xacro:Sharp_GP2Y0A21_IR_sim name="r180"/>
  <xacro:Sharp_GP2Y0A21_IR_sim name="r155"/>

  <!-- Fake range sensor to see where the cannon is pointing to -->
  <xacro:thorp_sim_ranger name="ir_cannon" link="ir_cannon_link" topic="/mobile_base/sensors/infrared/cannon"
                          h_samples="3" h_fov="0.001" v_samples="1" v_min="0.0" v_max="0.0"
                          min_range="0.1" max_range="5.0" noise="0.0" visualize="true"/>

  <!-- Gazebo configuration for other structural parts -->
  <xacro:macro name="structural_part" params="name color">
    <gazebo reference="${name}_link">
      <material>Gazebo/${color}</material>
    </gazebo>
  </xacro:macro>

  <xacro:structural_part name="sonars_mount" color="Black"/>
  <xacro:structural_part name="senz3d_mount" color="Black"/>
  <xacro:structural_part name="xtion_mount"  color="Black"/>
  <xacro:structural_part name="arm_mount"    color="Black"/>
  <xacro:structural_part name="opencm"       color="Black"/>
  <xacro:structural_part name="tray"         color="Yellow"/>
  <xacro:structural_part name="cannon"       color="Black"/>
  <xacro:structural_part name="cannon_servo" color="Black"/>
  <xacro:structural_part name="cannon_shaft" color="Black"/>
  <xacro:structural_part name="cannon_tube1" color="Black"/>
  <xacro:structural_part name="cannon_tube2" color="Black"/>
  <xacro:structural_part name="cannon_tube3" color="Black"/>
  <xacro:structural_part name="cannon_tube4" color="Black"/>
  <xacro:structural_part name="cannon_tube5" color="Black"/>
  <xacro:structural_part name="cannon_tube6" color="Black"/>
</robot>
