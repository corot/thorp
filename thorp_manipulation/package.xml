<?xml version="1.0"?>
<package format="2">
  <name>thorp_manipulation</name>
  <version>0.1.0</version>
  <description>
   The thorp_manipulation package handles Thorp's arm move groups and provides a simple ROS interface to use them.
  </description>
  <maintainer email="jsantossimon@gmail.com">Jorge Santos Simón</maintainer>
  <author email="jsantossimon@gmail.com">Jorge Santos Simón</author>

  <license>BSD</license>

  <url type="bugtracker">https://github.com/corot/thorp/issues</url>
  <url type="repository">https://github.com/corot/thorp</url>
  <url type="website">http://wiki.ros.org/thorp_manipulation</url>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>tf</depend>
  <depend>roscpp</depend>
  <depend>actionlib</depend>
  <depend>actionlib_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_core</depend>
  <depend>interactive_markers</depend>
  <depend>visualization_msgs</depend>
  <depend>gazebo_grasp_plugin_ros</depend>
  <depend>thorp_msgs</depend>
  <depend>thorp_toolkit</depend>

  <exec_depend>thorp_moveit_config</exec_depend>
  <exec_depend>turtlebot_arm_bringup</exec_depend>
  <exec_depend>dynamixel_controllers</exec_depend>
  <exec_depend>arbotix_controllers</exec_depend>
</package>
