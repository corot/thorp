<package format="2">
  <name>thorp_simulation</name>
  <version>0.1.0</version>
  <description>STDR, Stage and Gazebo launchers and worlds for Thorp simulation</description>
  <maintainer email="jsantossimon@gmail.com">Jorge Santos Simón</maintainer>
  <author email="jsantossimon@gmail.com">Jorge Santos Simón</author> 

  <license>BSD</license>

  <url type="bugtracker">https://github.com/corot/thorp/issues</url>
  <url type="repository">https://github.com/corot/thorp</url>
  <url type="website">http://wiki.ros.org/thorp_simulation</url> 

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>gazebo_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>thorp_toolkit</depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>stdr_server</exec_depend>
  <exec_depend>stdr_robot</exec_depend>
  <exec_depend>stdr_gui</exec_depend>
  <exec_depend>stage_ros</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros_control</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>hector_gazebo_plugins</exec_depend>
  <exec_depend>kobuki_gazebo_plugins</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>turtlebot_description</exec_depend>
  <exec_depend>diagnostic_aggregator</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>effort_controllers</exec_depend>
  <exec_depend>position_controllers</exec_depend>
  <exec_depend>joint_state_controller</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>

  <exec_depend>thorp_bringup</exec_depend>

  <export>
    <gazebo_ros gazebo_model_path="${prefix}/worlds/gazebo/models"/>
  </export>
</package>
