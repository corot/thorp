<?xml version="1.0" encoding="UTF-8"?>
<!--
  Trees for test/test_capabilities.py, that aren't capabilities themselves.
-->
<root BTCPP_format="4">
  <include path="manipulation.xml"/>

  <!--
    The robot side of the reset before each capability test: the gripper empty, the arm resting, out of the camera's
    view, and the planning scene empty, for the next detection to fill it with what the camera sees. The test puts
    the objects back in place on Gazebo.
  -->
  <BehaviorTree ID="test_reset_scene">
    <Sequence>
      <SubTree ID="clear_gripper"/>
      <SetArmConfig configuration="resting"
                    error="{error}"/>
      <ClearPlanningScene keep_tray="false"/>
    </Sequence>
  </BehaviorTree>
</root>
