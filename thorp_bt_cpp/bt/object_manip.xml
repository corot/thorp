<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <include path="manipulation.xml"/>

  <BehaviorTree ID="object_manip">
    <Repeat num_cycles="-1">
      <ReactiveSequence>
        <ReadUserCommands valid_commands="start;stop;reset;exit;clear;fold"
                          user_command="{user_command}"/>
        <Switch6 case_1="start"
                 case_2="stop"
                 case_3="reset"
                 case_4="exit"
                 case_5="clear"
                 case_6="fold"
                 variable="{user_command}">
          <ForceSuccess>
            <Sequence>
              <DetectObjects object_types=""
                             objects="{objects}"
                             surface="{surface}"/>
              <DragAndDrop objects="{objects}"
                           object_name="{object_name}"
                           pickup_pose="{pickup_pose}"
                           place_pose="{place_pose}"/>
              <ReadFloatParam param_name="gripper_tightening"
                              output_key="{tightening}"/>
              <SubTree ID="pickup_object"
                       object_name="{object_name}"
                       tightening="{tightening}"
                       error="{error}"/>
              <SubTree ID="place_object"
                       object_name="{object_name}"
                       place_pose="{place_pose}"
                       error="{error}"/>
            </Sequence>
          </ForceSuccess>
          <SetBlackboard value=""
                         output_key="user_command"/>
          <SetBlackboard value="start"
                         output_key="user_command"/>
          <AlwaysFailure/>
          <Sequence>
            <SubTree ID="clear_gripper"/>
            <SetBlackboard value=""
                           output_key="user_command"/>
          </Sequence>
          <Sequence>
            <SubTree ID="stow_arm"
                     error="{error}"/>
            <SetBlackboard value=""
                           output_key="user_command"/>
          </Sequence>
          <Sleep msec="10"/>
        </Switch6>
      </ReactiveSequence>
    </Repeat>
  </BehaviorTree>
</root>
