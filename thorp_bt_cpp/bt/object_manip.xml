<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="3">
  <include path="manipulation.xml"/>

  <BehaviorTree ID="object_manip">
    <Repeat num_cycles="-1">
      <ReactiveSequence>
        <ReadUserCommands user_command="{user_command}"/>
        <Switch6 case_1="start"
                 case_2="stop"
                 case_3="reset"
                 case_4="exit"
                 case_5="clear"
                 case_6="fold"
                 variable="{user_command}">
          <Sequence>
            <DetectObjects action_name="object_detection"
                           object_types=""
                           server_timeout="5.000000"
                           objects="{objects}"
                           surface="{surface}"/>
            <DragAndDrop action_name="drag_and_drop"
                         objects="{objects}"
                         server_timeout="5.000000"
                         feedback=""
                         object_name="{object_name}"
                         pickup_pose="{pickup_pose}"
                         place_pose="{place_pose}"/>
            <ReadDoubleParam key="gripper_tightening"
                             negate=""
                             value="{tightening}"/>
            <SubTree ID="pickup_object"
                     object_name="{object_name}"
                     tightening="{tightening}"
                     error="{error}"/>
            <SubTree ID="place_object"
                     object_name="{object_name}"
                     place_pose="{place_pose}"
                     error="{error}"/>
          </Sequence>
          <SetBlackboard value=""
                         output_key="user_command"/>
          <SetBlackboard value="start"
                         output_key="user_command"/>
          <AlwaysFailure/>
          <Sequence>
            <ClearGripper service_name="clear_gripper"
                          timeout="100"/>
            <SetBlackboard value=""
                           output_key="user_command"/>
          </Sequence>
          <Sequence>
            <SetArmConfig action_name="manipulation/move_to_target"
                          configuration="resting"
                          server_timeout="5.000000"
                          error="{error}"
                          feedback=""/>
            <SetBlackboard value=""
                           output_key="user_command"/>
          </Sequence>
          <Sleep duration="0.01"/>
        </Switch6>
      </ReactiveSequence>
    </Repeat>
  </BehaviorTree>
</root>
