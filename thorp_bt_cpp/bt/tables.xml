<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <!--
    Everything done at a manipulation surface (normally a table).
  -->
  <include path="perception.xml"/>

  <include path="navigation.xml"/>

  <include path="pickup_objects.xml"/>

  <!--
    Park against a table, on its side closest to the robot, ready to pick from or place on it: the table thorp_world
    knows as table_id, or the one in front if none is given. It goes first to the viewing pose on that side and detects
    the table again from there, as a view from further away sees little of it; then docks, and detects the objects on
    it, refreshing the world and the planning scene.
  -->
  <BehaviorTree ID="approach_table">
    <Sequence>
      <IfThenElse>
        <StringInBlackboard key="{table_id}"/>
        <GetTable table_id="{table_id}"
                  table="{table}"
                  table_pose="{table_pose}"
                  error="{error}"/>
        <SubTree ID="detect_table"
                 table="{table}"
                 table_pose="{table_pose}"
                 table_id="{table_id}"/>
      </IfThenElse>
      <GetRobotPose timeout="1"
                    robot_pose="{robot_pose}"
                    error="{error}"/>
      <ReadDoubleParam param_name="approach_dist_to_table"
                       output_key="{approach_dist_to_table}"/>
      <GetPosesAroundTable distance="{approach_dist_to_table}"
                           table="{table}"
                           table_pose="{table_pose}"
                           table_side_poses="{approach_poses}"/>
      <GetClosestPose poses="{approach_poses}"
                      target_pose="{robot_pose}"
                      closest_pose="{approach_pose}"/>
      <NavigateToPose goal="{approach_pose}"
                      error_code_id="{nav_error}"/>
      <!-- if the closer detection misses, go on with the table we have -->
      <ForceSuccess>
        <SubTree ID="detect_table"
                 table="{table}"
                 table_pose="{table_pose}"
                 table_id="{table_id}"/>
      </ForceSuccess>
      <ReadDoubleParam param_name="pickup_dist_to_table"
                       output_key="{pickup_dist_to_table}"/>
      <GetPosesAroundTable distance="{pickup_dist_to_table}"
                           split_long_sides="true"
                           table="{table}"
                           table_pose="{table_pose}"
                           table_side_poses="{pickup_poses}"/>
      <GetRobotPose timeout="1"
                    robot_pose="{robot_pose}"
                    error="{error}"/>
      <GetClosestPose poses="{pickup_poses}"
                      target_pose="{robot_pose}"
                      closest_pose="{pickup_pose}"/>
      <SubTree ID="reach_table"
               table_id="{table_id}"
               pose="{pickup_pose}"
               error="{error}"
               nav_error="{nav_error}"/>
      <SubTree ID="detect_objects"
               objects="{objects}"
               surface="{surface}"
               error="{error}"/>
    </Sequence>
  </BehaviorTree>

  <!--
    Dock at a table: straight to the pickup pose, under the table's eaves, precisely, recording it in thorp_world. The
    table access is cleared on the local costmap, so the controller doesn't take it as an obstacle. Docking that can't
    reach the pickup pose's tolerance fails after a minute, as the progress checker never stops a robot that keeps
    moving around the goal.
  -->
  <BehaviorTree ID="reach_table">
    <Sequence>
      <GetTable table_id="{table_id}"
                table="{table}"
                table_pose="{table_pose}"
                error="{error}"/>
      <ClearTableAccess table="{table}"
                        table_pose="{pose}"/>
      <GetRobotPose timeout="1"
                    robot_pose="{robot_pose}"
                    error="{error}"/>
      <PoseAsPath start="{robot_pose}"
                  pose="{pose}"
                  path="{path}"/>
      <Timeout msec="60000">
        <FollowPath path="{path}"
                    controller_id="Graceful"
                    goal_checker_id="precise_goal_checker"
                    error_code_id="{nav_error}"/>
      </Timeout>
      <ForceSuccess>
        <UpdateWorld effect="docked"
                     table_id="{table_id}"/>
      </ForceSuccess>
    </Sequence>
  </BehaviorTree>

  <!--
    Back straight out from the table the robot is at. reach_table drives in head-on, so backing up moves away from
    the table; it retreats as far as the pickup planner's detach poses do, far enough to navigate around the table
    again, and restores the table access reach_table cleared.
  -->
  <BehaviorTree ID="leave_table">
    <Sequence>
      <GetCurrentTable table_id="{table_id}"
                       error="{error}"/>
      <ReadDoubleParam param_name="pickup_dist_to_table"
                       output_key="{pickup_dist_to_table}"/>
      <ReadDoubleParam param_name="detach_dist_from_table"
                       output_key="{detach_dist_from_table}"/>
      <Script code="retreat := detach_dist_from_table - pickup_dist_to_table"/>
      <BackUp backup_dist="{retreat}"
              backup_speed="0.1"
              error_code_id="{nav_error}"/>
      <RestoreTableAccess table_name="{table_id}"/>
      <ForceSuccess>
        <UpdateWorld effect="undocked"/>
      </ForceSuccess>
    </Sequence>
  </BehaviorTree>

  <!--
    Look a table over from a viewing pose and report what is on it: the table thorp_world knows as table_id, or the one
    in front if none is given. The objects are for choosing what to do; they are detected from outside arm reach, so
    picking one still means approach_table, that detects them again from there.
  -->
  <BehaviorTree ID="inspect_table">
    <Sequence>
      <IfThenElse>
        <StringInBlackboard key="{table_id}"/>
        <GetTable table_id="{table_id}"
                  table="{table}"
                  table_pose="{table_pose}"
                  error="{error}"/>
        <AlwaysSuccess/>
      </IfThenElse>
      <SubTree ID="validate_table"
               table="{table}"
               table_pose="{table_pose}"
               table_id="{table_id}"
               inspect_pose="{inspect_pose}"/>
      <SubTree ID="detect_objects"
               objects="{objects}"
               surface="{surface}"
               error="{error}"/>
    </Sequence>
  </BehaviorTree>

  <!--
    Drive to the viewing pose of a table thorp_world knows: the closest of those facing each of its sides, outside arm
    reach. From there the table is in view, for detecting, inspecting or approaching it.
  -->
  <BehaviorTree ID="go_to_table">
    <Sequence>
      <GetTable table_id="{table_id}"
                table="{table}"
                table_pose="{table_pose}"
                error="{error}"/>
      <ReadDoubleParam param_name="approach_dist_to_table"
                       output_key="{approach_dist_to_table}"/>
      <GetPosesAroundTable distance="{approach_dist_to_table}"
                           table="{table}"
                           table_pose="{table_pose}"
                           table_side_poses="{approach_poses}"/>
      <GetRobotPose timeout="1"
                    error="{error}"
                    robot_pose="{robot_pose}"/>
      <GetClosestPose poses="{approach_poses}"
                      target_pose="{robot_pose}"
                      closest_pose="{inspect_pose}"/>
      <NavigateToPose goal="{inspect_pose}"
                      error_code_id="{nav_error}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="validate_table">
    <Sequence>
      <GetRobotPose timeout="1"
                    error="{error}"
                    robot_pose="{robot_pose}"/>
      <!--
        Turn to face the table before inspecting it, but only if we have been told where it
        is. Inside object_gatherer the parent has already detected one, so {table_pose} is on
        the blackboard and this looks at it. Run on its own as a capability there is no table
        pose yet; PoseInBlackboard checks that from xml.
      -->
      <Fallback>
        <Inverter>
          <PoseInBlackboard key="{table_pose}"/>
        </Inverter>
        <LookAtPose robot_pose="{robot_pose}"
                    target_pose="{table_pose}"
                    error="{error}"/>
      </Fallback>
      <!--
        Detect it again, now in front; if that misses, as a far or small table can be at the detection limit, go on
        with the table we were given. Detecting it from the viewing pose, much closer, must succeed.
      -->
      <Fallback>
        <DetectTables table="{table}"
                      table_pose="{table_pose}"
                      table_id="{table_id}"/>
        <PoseInBlackboard key="{table_pose}"/>
      </Fallback>
      <SubTree ID="go_to_table"
               table_id="{table_id}"
               inspect_pose="{inspect_pose}"
               error="{error}"
               nav_error="{nav_error}"/>
      <DetectTables table="{table}"
                    table_pose="{table_pose}"
                    table_id="{table_id}"/>
      <ForceSuccess>
        <UpdateWorld effect="inspected"
                     table_id="{table_id}"/>
      </ForceSuccess>
      <TableAsObstacle table="{table}"
                       table_pose="{table_pose}"/>
      <TableValidSize table="{table}"/>
    </Sequence>
  </BehaviorTree>

  <!--
    Pick every object on a table and put it on the tray, from as few pickup locations around it as possible: the table
    thorp_world knows as table_id, or the one in front if none is given, validated and looked over from a viewing pose.
  -->
  <BehaviorTree ID="cleanup_table">
    <Sequence>
      <IfThenElse>
        <StringInBlackboard key="{table_id}"/>
        <GetTable table_id="{table_id}"
                  table="{table}"
                  table_pose="{table_pose}"
                  error="{error}"/>
        <SubTree ID="validate_table"
                 table="{table}"
                 table_pose="{table_pose}"
                 table_id="{table_id}"
                 inspect_pose="{inspect_pose}"/>
      </IfThenElse>
      <ReadDoubleParam param_name="pickup_dist_to_table"
                       output_key="{pickup_dist_to_table}"/>
      <GetPosesAroundTable distance="{pickup_dist_to_table}"
                           split_long_sides="true"
                           table="{table}"
                           table_pose="{table_pose}"
                           table_side_poses="{pickup_poses}"/>
      <Repeat num_cycles="2"
              _description="Recheck that we left no objects behind">
        <Fallback>
          <Sequence>
            <DetectObjects object_types=""
                           objects="{objects}"
                           surface="{surface}"/>
            <Inverter>
              <ObjectsDetected given_up_count="{given_up_count}"
                               ignore_given_up="true"
                               objects="{objects}"/>
            </Inverter>
            <ClearPlanningScene keep_tray="true"/>
          </Sequence>
          <Sequence>
            <GetRobotPose timeout="1"
                          error="{error}"
                          robot_pose="{robot_pose}"/>
            <PlanPickupLocations table_id="{table_id}"
                                 pickup_poses="{pickup_poses}"
                                 robot_pose="{robot_pose}"
                                 pickup_plan="{pickup_plan}"/>
            <ForEachPickupLocation element="{pickup_location}"
                                   list="{pickup_plan}">
              <Sequence>
                <ExpandPickupLocation pickup_location="{pickup_location}"
                                      approach_pose="{approach_pose}"
                                      detach_pose="{detach_pose}"
                                      pickup_pose="{pickup_pose}"/>
                <NavigateToPose goal="{approach_pose}"
                                error_code_id="{nav_error}"/>
                <SubTree ID="reach_table"
                         table_id="{table_id}"
                         pose="{pickup_pose}"/>
                <SubTree ID="pickup_objects"/>
                <ClearPlanningScene keep_tray="true"/>
                <SubTree ID="leave_table"/>
              </Sequence>
            </ForEachPickupLocation>
          </Sequence>
        </Fallback>
      </Repeat>
    </Sequence>
  </BehaviorTree>
</root>
