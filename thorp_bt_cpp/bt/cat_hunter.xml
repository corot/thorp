<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <include path="explore_house.xml"/>

  <!--
    Explore the house looking for cats, and hunt each one seen: approach it, and fire the cannon at it while following
    it. Ends when the ammo or the exploration does.
  -->
  <BehaviorTree ID="cat_hunter">
    <KeepRunningUntilFailure>
      <Sequence>
        <CannonHasAmmo/>
        <Parallel failure_count="1"
                  success_count="1">
          <ForceFailure>
            <SubTree ID="explore_house"/>
          </ForceFailure>
          <MonitorTarget target_pose="{target_pose}"/>
        </Parallel>
        <!-- A target lost while approaching it is left; exploring goes on -->
        <IfThenElse>
          <SubTree ID="approach_target"/>
          <SubTree ID="hunt_cat"/>
          <AlwaysSuccess/>
        </IfThenElse>
      </Sequence>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <!--
    Follow the target until it is within the cannon's sight, checking that on its latest pose. Fails if the target
    gets lost, or isn't within sight after 25 seconds.
  -->
  <BehaviorTree ID="approach_target">
    <Parallel failure_count="1"
              success_count="1">
      <ForceFailure>
        <FollowObject max_duration="25"
                      error="{follow_error}"/>
      </ForceFailure>
      <RetryUntilSuccessful num_attempts="-1">
        <Sequence>
          <MonitorTarget target_pose="{target_pose}"/>
          <GetRobotPose robot_pose="{robot_pose}"
                        error="{error}"
                        timeout="1"/>
          <TargetReachable robot_pose="{robot_pose}"
                           target_pose="{target_pose}"
                           max_dist="1.5"
                           max_angle="1.5"/>
        </Sequence>
      </RetryUntilSuccessful>
    </Parallel>
  </BehaviorTree>

  <!--
    Follow the target, aiming and firing at it whenever it is close and in front. Ends when the target is not seen for
    half a second, as when toppled, or there's no ammo left, with the cannon leveled.
  -->
  <BehaviorTree ID="hunt_cat">
    <!-- Leveled however the hunt ends: tilted down, the cannon collides with the top plate in MoveIt's model,
         and manipulation can't plan -->
    <Fallback>
      <Sequence>
        <Parallel failure_count="1"
                  success_count="1">
          <ForceSuccess>
            <FollowObject error="{follow_error}"/>
          </ForceSuccess>
          <RetryUntilSuccessful num_attempts="-1">
            <IfThenElse>
              <Sequence>
                <CannonHasAmmo/>
                <MonitorTarget name="TargetVisible"
                               target_pose="{target_pose}"
                               timeout="0.5"/>
              </Sequence>
              <Sequence>
                <GetRobotPose robot_pose="{robot_pose}"
                              error="{error}"
                              timeout="1"/>
                <TargetReachable robot_pose="{robot_pose}"
                                 target_pose="{target_pose}"
                                 max_dist="1.0"
                                 max_angle="0.2"/>
                <AimCannon target_pose="{target_pose}"
                           angle="{cannon_tilt_angle}"/>
                <TiltCannon angle="{cannon_tilt_angle}"/>
                <FireCannon shots="1"/>
                <Sleep msec="1000"/>
                <AlwaysFailure _description="Keep hunting while the target is visible"/>
              </Sequence>
              <AlwaysSuccess/>
            </IfThenElse>
          </RetryUntilSuccessful>
        </Parallel>
        <TiltCannon angle="0"/>
      </Sequence>
      <Sequence>
        <TiltCannon angle="0"/>
        <AlwaysFailure/>
      </Sequence>
    </Fallback>
  </BehaviorTree>
</root>
