<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="pickup_object">
    <Sequence>
      <ForceSuccess>
        <Sequence>
          <Fallback>
            <ObjectAttached service_name="obj_attached"
                            timeout="100"
                            attached_object="{attached_object}"/>
            <GripperBusy service_name="gripper_busy"
                         timeout="100"
                         attached_object="{attached_object}"/>
          </Fallback>
          <ClearGripper service_name="clear_gripper"
                        timeout="100"/>
        </Sequence>
      </ForceSuccess>
      <ReadFloatParam param_name="gripper_max_effort"
                      output_key="{max_effort}"/>
      <RecoverAndRetry>
        <PickupObject action_name="manipulation/pickup_object"
                      max_effort="{max_effort}"
                      object_name="{object_name}"
                      server_timeout="5.000000"
                      support_surf="table"
                      tightening="{tightening}"
                      error="{error}"
                      feedback=""/>
        <ClearOctomap service_name="clear_octomap"
                      timeout="100"/>
      </RecoverAndRetry>
      <Fallback>
        <GripperBusy service_name="gripper_busy"
                     timeout="100"
                     attached_object="{attached_object}"/>
        <ForceFailure>
          <ClearGripper service_name="clear_gripper"
                        timeout="100"/>
        </ForceFailure>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="place_object">
    <RecoverAndRetry>
      <PlaceObject action_name="manipulation/place_object"
                   object_name="{object_name}"
                   place_pose="{place_pose}"
                   server_timeout="5.000000"
                   support_surf="table"
                   error="{error}"
                   feedback=""/>
      <ClearOctomap service_name="clear_octomap"
                    timeout="100"/>
    </RecoverAndRetry>
  </BehaviorTree>

  <BehaviorTree ID="place_on_tray">
    <Sequence>
      <NextPoseOnTray service_name="manipulation/tray/get_next_pose"
                      timeout="100"
                      pose_on_tray="{pose_on_tray}"/>
      <RecoverAndRetry>
        <PlaceObject action_name="manipulation/place_object"
                     object_name="{object_name}"
                     place_pose="{pose_on_tray}"
                     server_timeout="5.000000"
                     support_surf="tray"
                     error="{error}"
                     feedback=""/>
        <ClearOctomap service_name="clear_octomap"
                      timeout="100"/>
        <NextPoseOnTray service_name="manipulation/tray/get_next_pose"
                        timeout="100"
                        pose_on_tray="{pose_on_tray}"/>
      </RecoverAndRetry>
      <AddObjectToTray object_name="{object_name}"
                       pose_on_tray="{pose_on_tray}"
                       service_name="manipulation/tray/add_object"
                       timeout="100"/>
    </Sequence>
  </BehaviorTree>
</root>
