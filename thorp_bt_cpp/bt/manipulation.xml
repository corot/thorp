<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="pickup_object">
    <Sequence>
      <ForceSuccess>
        <Sequence>
          <ObjectAttached attached_object="{attached_object}"/>
          <SubTree ID="clear_gripper"/>
        </Sequence>
      </ForceSuccess>
      <ReadFloatParam param_name="gripper_max_effort"
                      output_key="{max_effort}"/>
      <!-- tightening is optional: the caller's if given, else the gripper_tightening parameter -->
      <Fallback>
        <FloatInBlackboard key="{tightening}"/>
        <ReadFloatParam param_name="gripper_tightening"
                        output_key="{tightening}"/>
      </Fallback>
      <RecoverAndRetry>
        <PickupObject max_effort="{max_effort}"
                      object_name="{object_name}"
                      support_surf="table"
                      tightening="{tightening}"
                      error="{error}"/>
        <ClearOctomap service_name="clear_octomap"
                      timeout="100"/>
      </RecoverAndRetry>
      <!-- the planning scene has the object attached, but only the gripper can tell whether it really holds it -->
      <Fallback>
        <Sequence>
          <GripperBusy/>
          <ObjectAttached attached_object="{attached_object}"/>
        </Sequence>
        <ForceFailure>
          <SubTree ID="clear_gripper"/>
        </ForceFailure>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="place_object">
    <RecoverAndRetry>
      <PlaceObject object_name="{object_name}"
                   place_pose="{place_pose}"
                   support_surf="table"
                   error="{error}"/>
      <ClearOctomap service_name="clear_octomap"
                    timeout="100"/>
    </RecoverAndRetry>
  </BehaviorTree>

  <BehaviorTree ID="place_on_tray">
    <Sequence>
      <NextPoseOnTray pose_on_tray="{pose_on_tray}"/>
      <RecoverAndRetry>
        <PlaceObject object_name="{object_name}"
                     place_pose="{pose_on_tray}"
                     support_surf="tray_link"
                     error="{error}"/>
        <ClearOctomap service_name="clear_octomap"
                      timeout="100"/>
        <NextPoseOnTray pose_on_tray="{pose_on_tray}"/>
      </RecoverAndRetry>
    </Sequence>
  </BehaviorTree>

  <!-- Open the gripper, and detach and remove from the planning scene whatever object it held -->
  <BehaviorTree ID="clear_gripper">
    <Sequence>
      <MoveGripper/>
      <ForceSuccess>
        <Sequence>
          <ObjectAttached attached_object="{attached_object}"/>
          <DetachObject object_name="{attached_object}"/>
        </Sequence>
      </ForceSuccess>
    </Sequence>
  </BehaviorTree>
</root>
