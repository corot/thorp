<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <include path="explore_house.xml"/>

  <include path="tables.xml"/>

  <BehaviorTree ID="object_gatherer">
    <KeepRunningUntilFailure>
      <Sequence>
        <Parallel failure_count="1"
                  success_count="1">
          <ForceFailure>
            <SubTree ID="explore_house"/>
          </ForceFailure>
          <RetryUntilSuccessful num_attempts="-1">
            <Sequence>
              <DetectTables action_name="rail_segmentation/segment_objects"
                            server_timeout="5"
                            table="{table}"
                            table_pose="{table_pose}"/>
              <Inverter>
                <TableVisited table="{table}"
                              table_pose="{table_pose}"/>
              </Inverter>
            </Sequence>
          </RetryUntilSuccessful>
        </Parallel>
        <IfThenElse>
          <SubTree ID="validate_table"
                   table_pose="{table_pose}"
                   table="{table}"/>
          <SubTree ID="cleanup_table"
                   table_pose="{table_pose}"
                   table="{table}"/>
          <AlwaysSuccess/>
        </IfThenElse>
      </Sequence>
    </KeepRunningUntilFailure>
  </BehaviorTree>
</root>
