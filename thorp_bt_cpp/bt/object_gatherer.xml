<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <include path="explore_house.xml"/>

  <include path="tables.xml"/>

  <!--
    Explore the house looking for tables, and clean up each new one found: explore until detecting a table not visited
    yet, validate it, pick all its objects onto the tray, and resume exploring. Ends when the exploration does.
  -->
  <BehaviorTree ID="object_gatherer">
    <KeepRunningUntilFailure>
      <Sequence>
        <Parallel failure_count="1"
                  success_count="1">
          <ForceFailure>
            <SubTree ID="explore_house"/>
          </ForceFailure>
          <RetryUntilSuccessful num_attempts="-1">
            <Sequence>
              <DetectTables table="{table}"
                            table_pose="{table_pose}"/>
              <Inverter>
                <TableVisited table="{table}"
                              table_pose="{table_pose}"/>
              </Inverter>
            </Sequence>
          </RetryUntilSuccessful>
        </Parallel>
        <!-- A table that can't be cleaned up is left as it is; validation marked it visited, so exploring goes on -->
        <IfThenElse>
          <SubTree ID="validate_table"
                   table="{table}"
                   table_pose="{table_pose}"
                   inspect_pose="{inspect_pose}"/>
          <ForceSuccess>
            <SubTree ID="cleanup_table"
                     table="{table}"
                     table_pose="{table_pose}"/>
          </ForceSuccess>
          <AlwaysSuccess/>
        </IfThenElse>
      </Sequence>
    </KeepRunningUntilFailure>
  </BehaviorTree>
</root>
