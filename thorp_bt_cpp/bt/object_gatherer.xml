<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <include path="navigation.xml"/>

  <include path="explore_house.xml"/>

  <include path="pickup_objects.xml"/>

  <BehaviorTree ID="cleanup_table">
    <Sequence>
      <ReadDoubleParam param_name="pickup_dist_to_table"
                       output_key="{pickup_dist_to_table}"/>
      <GetPosesAroundTable distance="{pickup_dist_to_table}"
                           split_long_sides="true"
                           table="{table}"
                           table_pose="{table_pose}"
                           table_side_poses="{pickup_poses}"/>
      <Repeat num_cycles="2"
              _description="Recheck that we left no objects behind">
        <Fallback>
          <Sequence>
            <DetectObjects action_name="object_detection"
                           object_types=""
                           server_timeout="5.000000"
                           objects="{objects}"
                           surface="{surface}"/>
            <Inverter>
              <ObjectsDetected given_up_count="{given_up_count}"
                               ignore_given_up="true"
                               objects="{objects}"/>
            </Inverter>
            <ClearRailMarkers service_name="rail_segmentation/clear_markers"
                              timeout="100"/>
            <ClearPlanningScene keep_tray="true"
                                service_name="manipulation/clear_planning_scene"
                                timeout="100"/>
          </Sequence>
          <Sequence>
            <GetRobotPose timeout="1"
                          error="{error}"
                          robot_pose="{robot_pose}"/>
            <MakePickupPlan action_name="manipulation/make_pickup_plan"
                            objects="{objects}"
                            pickup_poses="{pickup_poses}"
                            robot_pose="{robot_pose}"
                            server_timeout="5.000000"
                            surface="{surface}"
                            pickup_plan="{pickup_plan}"/>
            <ForEachPickupLocation element="{pickup_location}"
                                   list="{pickup_plan}">
              <Sequence>
                <ExpandPickupLocation pickup_location="{pickup_location}"
                                      approach_pose="{approach_pose}"
                                      detach_pose="{detach_pose}"
                                      pickup_pose="{pickup_pose}"/>
                <GoToPose action_name="move_base_flex/move_base"
                          angle_tolerance=""
                          controller="TEBPlanner"
                          dist_tolerance=""
                          planner=""
                          pose="{approach_pose}"
                          server_timeout="5.000000"
                          error="{error}"
                          feedback="{goto_pose_feedback}"/>
                <SubTree ID="attach_to_table"
                         table="{table}"
                         pose="{pickup_pose}"/>
                <SubTree ID="pickup_objects"/>
                <ClearRailMarkers service_name="rail_segmentation/clear_markers"
                                  timeout="100"/>
                <ClearPlanningScene keep_tray="true"
                                    service_name="manipulation/clear_planning_scene"
                                    timeout="100"/>
                <SubTree ID="detach_from_table"
                         table="{table}"
                         pose="{detach_pose}"/>
              </Sequence>
            </ForEachPickupLocation>
          </Sequence>
        </Fallback>
      </Repeat>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="object_gatherer">
    <KeepRunningUntilFailure>
      <Sequence>
        <Parallel failure_count="1"
                  success_count="1">
          <ForceFailure>
            <SubTree ID="explore_house"/>
          </ForceFailure>
          <RetryUntilSuccessful num_attempts="-1">
            <Sequence>
              <DetectTables action_name="rail_segmentation/segment_objects"
                            server_timeout="5"
                            table="{table}"
                            table_pose="{table_pose}"/>
              <Inverter>
                <TableVisited table="{table}"
                              table_pose="{table_pose}"/>
              </Inverter>
            </Sequence>
          </RetryUntilSuccessful>
        </Parallel>
        <IfThenElse>
          <SubTree ID="validate_table"
                   table_pose="{table_pose}"
                   table="{table}"/>
          <SubTree ID="cleanup_table"
                   table_pose="{table_pose}"
                   table="{table}"/>
          <AlwaysSuccess/>
        </IfThenElse>
      </Sequence>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <BehaviorTree ID="validate_table">
    <Sequence>
      <GetRobotPose timeout="1"
                    error="{error}"
                    robot_pose="{robot_pose}"/>
      <LookAtPose action_name="move_base_flex/exe_path"
                  controller="TEBPlanner"
                  robot_pose="{robot_pose}"
                  server_timeout="5.000000"
                  target_pose="{table_pose}"
                  error="{error}"
                  feedback="{look_at_feedback}"/>
      <DetectTables action_name="rail_segmentation/segment_objects"
                    server_timeout="5"
                    table="{table}"
                    table_pose="{table_pose}"/>
      <ReadDoubleParam param_name="approach_dist_to_table"
                       output_key="{approach_dist_to_table}"/>
      <GetPosesAroundTable distance="{approach_dist_to_table}"
                           table="{table}"
                           table_pose="{table_pose}"
                           table_side_poses="{approach_poses}"/>
      <GetClosestPose poses="{approach_poses}"
                      target_pose="{robot_pose}"
                      closest_pose="{inspect_pose}"/>
      <GoToPose action_name="move_base_flex/move_base"
                angle_tolerance=""
                controller="TEBPlanner"
                dist_tolerance=""
                planner=""
                pose="{inspect_pose}"
                server_timeout="5.000000"
                error="{error}"
                feedback="{goto_pose_feedback}"/>
      <DetectTables action_name="rail_segmentation/segment_objects"
                    server_timeout="5"
                    table="{table}"
                    table_pose="{table_pose}"/>
      <TableAsObstacle table="{table}"
                       table_pose="{table_pose}"/>
      <TableValidSize table="{table}"/>
    </Sequence>
  </BehaviorTree>
</root>
