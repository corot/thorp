<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="attach_to_table">
    <Parallel failure_count="1"
              success_count="1">
      <Sequence>
        <DisableSafetyController/>
        <ClearTableAccess table="{table}"
                          table_pose="{pose}"/>
        <PoseAsPath pose="{pose}"
                    path="{path}"/>
        <WhileDoElse>
          <Inverter>
            <BumperPressed/>
          </Inverter>
          <ExePath action_name="move_base_flex/exe_path"
                   controller="TEBPlanner"
                   path="{path}"
                   server_timeout="5.000000"
                   error="{error}"
                   feedback="{exe_path_feedback}"/>
          <AlwaysSuccess/>
        </WhileDoElse>
      </Sequence>
      <UseNamedConfig config_name="precise_controlling"
                      source_ns="named_configuration"
                      target_ns=""/>
    </Parallel>
  </BehaviorTree>

  <BehaviorTree ID="detach_from_table">
    <Parallel failure_count="1"
              success_count="1">
      <Sequence>
        <PoseAsPath pose="{pose}"
                    path="{path}"/>
        <ExePath action_name="move_base_flex/exe_path"
                 controller="TEBPlanner"
                 path="{path}"
                 server_timeout="5.000000"
                 error="{error}"
                 feedback="{exe_path_feedback}"/>
        <RestoreTableAccess table="{table}"/>
        <EnableSafetyController/>
      </Sequence>
      <UseNamedConfig config_name="precise_controlling"
                      source_ns="named_configuration"
                      target_ns=""/>
    </Parallel>
  </BehaviorTree>

  <BehaviorTree ID="follow_waypoints">
    <Sequence>
      <SubTree ID="reach_first_pose"
               poses="{waypoints}"/>
      <RetryUntilSuccessful num_attempts="-1">
        <Fallback>
          <Parallel failure_count="1"
                    success_count="1">
            <UseNamedConfig config_name="waypoints_following"
                            source_ns="named_configuration"
                            target_ns=""/>
            <Sequence>
              <SmoothPath service_name="waypoints_path/connect_waypoints"
                          timeout="100"
                          waypoints="{waypoints}"
                          path="{path}"/>
              <ExePath action_name="move_base_flex/exe_path"
                       controller="TEBPlanner"
                       path="{path}"
                       server_timeout="5.000000"
                       error="{exe_path_error}"
                       feedback="{exe_path_feedback}"/>
            </Sequence>
            <ReactiveSequence>
              <GetRobotPose timeout="1"
                            error="{error}"
                            robot_pose="{robot_pose}"/>
              <TrackProgress reached_threshold="1"
                             robot_pose="{robot_pose}"
                             next_waypoint="{next_waypoint}"
                             waypoints="{waypoints}"/>
            </ReactiveSequence>
          </Parallel>
          <Sequence>
            <SubTree ID="reach_first_pose"
                     poses="{waypoints}"/>
            <IsPoseListEmpty list="{waypoints}"/>
          </Sequence>
        </Fallback>
      </RetryUntilSuccessful>
      <ClearPoseList list="{waypoints}"/>
    </Sequence>
  </BehaviorTree>

  <!--
    Drive to one pose, with no list and no retrying: the single pose counterpart of
    reach_first_pose, for a caller that has already decided where it wants to be. Empty
    tolerances mean "leave the controller's own alone", so unlike reach_first_pose (which
    passes 3.15 rad and so ignores the final heading) this one stops facing the given yaw.
  -->
  <BehaviorTree ID="goto_pose">
    <GoToPose action_name="move_base_flex/move_base"
              angle_tolerance=""
              controller="TEBPlanner"
              dist_tolerance=""
              planner=""
              pose="{pose}"
              server_timeout="5.000000"
              error="{error}"
              feedback="{goto_pose_feedback}"/>
  </BehaviorTree>

  <!--
    Where to stand to work at a table: one pose per side, each `distance` out from it and
    facing it. This is the step between detecting a table and approaching it, and it is here
    rather than with the perception trees because what it produces is somewhere to drive to.

    cleanup_table does this internally with the pickup_dist_to_table parameter; exposed on its
    own, the caller chooses the distance, so the same node serves approaching to manipulate
    (approach_dist_to_table) and getting close enough to pick (pickup_dist_to_table).
  -->
  <BehaviorTree ID="poses_around_table">
    <GetPosesAroundTable distance="{distance}"
                         split_long_sides="false"
                         table="{table}"
                         table_pose="{table_pose}"
                         table_side_poses="{table_side_poses}"/>
  </BehaviorTree>

  <!--
    Which of these poses is nearest the robot, and where the robot is while we are at it.

    poses_around_table hands back one pose per side in a fixed geometric order, not sorted by
    anything, so "the first one" is whichever side the table's own frame calls +x. Use this to
    pick the near side; taking the first pose sends the robot round to the far one, where the
    objects are out of arm reach.
  -->
  <BehaviorTree ID="closest_pose">
    <Sequence>
      <GetRobotPose timeout="1"
                    robot_pose="{robot_pose}"
                    error="{error}"/>
      <GetClosestPose poses="{poses}"
                      target_pose="{robot_pose}"
                      closest_pose="{closest_pose}"/>
    </Sequence>
  </BehaviorTree>

  <!--
    Turn on the spot to face a pose, without translating: exe_path with a rotation, rather than
    move_base as goto_pose uses. Use it to point the camera, which is fixed to the base.
  -->
  <BehaviorTree ID="look_at_pose">
    <Sequence>
      <GetRobotPose timeout="1"
                    robot_pose="{robot_pose}"
                    error="{error}"/>
      <LookAtPose action_name="move_base_flex/exe_path"
                  controller="TEBPlanner"
                  robot_pose="{robot_pose}"
                  target_pose="{pose}"
                  server_timeout="5.000000"
                  error="{error}"
                  feedback="{look_at_feedback}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="reach_first_pose">
    <RetryUntilSuccessful num_attempts="-1">
      <Fallback>
        <Sequence>
          <GetPoseListFront list="{poses}"
                            element="{next_pose}"/>
          <GoToPose action_name="move_base_flex/move_base"
                    angle_tolerance="3.15"
                    controller="TEBPlanner"
                    dist_tolerance="0.3"
                    planner=""
                    pose="{next_pose}"
                    server_timeout="5.000000"
                    error="{goto_pose_error}"
                    feedback="{goto_pose_feedback}"/>
        </Sequence>
        <Inverter>
          <PopPoseFromList element="{next_pose}"
                           list="{poses}"/>
        </Inverter>
      </Fallback>
    </RetryUntilSuccessful>
  </BehaviorTree>
</root>
