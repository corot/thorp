<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <!--
    Go through a list of waypoints with Nav2's navigate_through_poses, dropping the waypoints passed by within Nav2's
    distance to drop them; only the last one's heading is reached. After a failure, as Nav2 fails if it can't plan the
    path to any of them, it goes to the next waypoint alone, skipping it if unreachable, and resumes from the one after.
  -->
  <BehaviorTree ID="follow_waypoints">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <Fallback>
          <Parallel failure_count="1"
                    success_count="1">
            <NavigateThroughPoses goals="{waypoints}"
                                  error_code_id="{nav_error}"/>
            <ReactiveSequence>
              <GetRobotPose timeout="1"
                            error="{error}"
                            robot_pose="{robot_pose}"/>
              <TrackProgress reached_threshold="0.5"
                             robot_pose="{robot_pose}"
                             next_waypoint="{next_waypoint}"
                             waypoints="{waypoints}"/>
            </ReactiveSequence>
          </Parallel>
          <Sequence>
            <SubTree ID="reach_first_pose"
                     poses="{waypoints}"/>
            <ForceSuccess>
              <PopPoseFromList element="{next_pose}"
                               list="{waypoints}"/>
            </ForceSuccess>
            <IsPoseListEmpty list="{waypoints}"/>
          </Sequence>
        </Fallback>
      </RetryUntilSuccessful>
      <ClearPoseList list="{waypoints}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="goto_pose">
    <Sequence>
      <PublishPose pose="{pose}"/>
      <NavigateToPose goal="{pose}"
                      error_code_id="{nav_error}"/>
    </Sequence>
  </BehaviorTree>

  <!--
    Turn on the spot to face a pose, without translating. Use it to point the camera, which is
    fixed to the base.
  -->
  <BehaviorTree ID="look_at_pose">
    <Sequence>
      <GetRobotPose timeout="1"
                    robot_pose="{robot_pose}"
                    error="{error}"/>
      <LookAtPose robot_pose="{robot_pose}"
                  target_pose="{pose}"
                  error="{error}"/>
    </Sequence>
  </BehaviorTree>

  <!-- Go to the first pose of the list we can reach, dropping those we can't -->
  <BehaviorTree ID="reach_first_pose">
    <RetryUntilSuccessful num_attempts="-1">
      <Fallback>
        <Sequence>
          <GetPoseListFront list="{poses}"
                            element="{next_pose}"/>
          <NavigateToPose goal="{next_pose}"
                          error_code_id="{goto_pose_error}"/>
        </Sequence>
        <Inverter>
          <PopPoseFromList element="{next_pose}"
                           list="{poses}"/>
        </Inverter>
      </Fallback>
    </RetryUntilSuccessful>
  </BehaviorTree>
</root>
