<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <include path="exploration.xml"/>

  <!-- Explore the whole house, with the given strategy or else the exploration_method parameter's; fails on others -->
  <BehaviorTree ID="explore_house">
    <Sequence>
      <Fallback>
        <StringInBlackboard key="{exploration_method}"/>
        <ReadStringParam param_name="exploration_method"
                         output_key="{exploration_method}"/>
      </Fallback>
      <Switch2 variable="{exploration_method}"
               case_1="cover_in_one_tour"
               case_2="cover_room_by_room">
        <SubTree ID="cover_in_one_tour"/>
        <SubTree ID="cover_room_by_room"/>
        <AlwaysFailure/>
      </Switch2>
    </Sequence>
  </BehaviorTree>
</root>
