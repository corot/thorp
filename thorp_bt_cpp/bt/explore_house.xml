<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <include path="exploration.xml"/>

  <BehaviorTree ID="explore_house">
    <Sequence>
      <ReadStringParam output_key="{exploration_method}"
                       param_name="exploration_method"/>
      <SubTree ID="full_coverage_planner"
               _skipIf="exploration_method != 'full_coverage_planner'"/>
      <SubTree ID="per_room_coverage"
               _skipIf="exploration_method != 'per_room_coverage'"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="ReadStringParam">
      <output_port name="output_key"
                   type="std::string"/>
      <input_port name="param_name"
                  type="std::string"/>
    </Action>
  </TreeNodesModel>

</root>
