<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <!-- Patrol ten times between two open areas of the playground map, around its obstacles -->
  <BehaviorTree ID="patrol_2_points">
    <Repeat num_cycles="10">
      <Sequence>
        <NavigateToPose goal="0;map;2.5;2.5;0;0;0;0.7071;0.7071"
                        error_code_id="{nav_error}"/>
        <NavigateToPose goal="0;map;-4.0;-4.5;0;0;0;-0.7071;0.7071"
                        error_code_id="{nav_error}"/>
      </Sequence>
    </Repeat>
  </BehaviorTree>
</root>
