<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <!-- Patrol ten times between two open areas of the playground map, around its obstacles -->
  <BehaviorTree ID="patrol_2_points">
    <Repeat num_cycles="10">
      <Sequence>
        <NavigateToPose goal="2.5;2.5;1.5708;map"
                        error_code_id="{nav_error}"/>
        <NavigateToPose goal="-4.0;-4.5;-1.5708;map"
                        error_code_id="{nav_error}"/>
      </Sequence>
    </Repeat>
  </BehaviorTree>
</root>
