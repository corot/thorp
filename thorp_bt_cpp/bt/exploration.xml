<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <include path="navigation.xml"/>

  <!--
    Explore the whole map at once: plan the poses from where the camera sees all of it, from where the robot stands,
    and follow them as waypoints. Resumes the waypoints left, if any.
  -->
  <BehaviorTree ID="full_coverage_planner">
    <Sequence>
      <Fallback>
        <Inverter>
          <IsPoseListEmpty list="{coverage_waypoints}"/>
        </Inverter>
        <Sequence>
          <GetRobotPose timeout="1"
                        error="{error}"
                        robot_pose="{robot_pose}"/>
          <PlanRoomExploration robot_pose="{robot_pose}"
                               room_number="0"
                               coverage_waypoints="{coverage_waypoints}"/>
        </Sequence>
      </Fallback>
      <SubTree ID="follow_waypoints"
               waypoints="{coverage_waypoints}"/>
    </Sequence>
  </BehaviorTree>

  <!--
    Explore the map room by room: segment it into rooms and order them from where the robot stands; then, for each
    room, plan the poses from where the camera sees all of it and follow them as waypoints. Resumes the rooms and
    waypoints left, if any.
  -->
  <BehaviorTree ID="per_room_coverage">
    <Sequence>
      <Fallback>
        <Inverter>
          <IsUIntListEmpty list="{room_sequence}"/>
        </Inverter>
        <Sequence>
          <SegmentRooms rooms="{rooms}"/>
          <GetRobotPose timeout="1"
                        error="{error}"
                        robot_pose="{robot_pose}"/>
          <PlanRoomSequence robot_pose="{robot_pose}"
                            rooms="{rooms}"
                            room_sequence="{room_sequence}"/>
        </Sequence>
      </Fallback>
      <RetryUntilSuccessful num_attempts="-1">
        <Sequence>
          <Fallback>
            <Inverter>
              <IsPoseListEmpty list="{coverage_waypoints}"/>
            </Inverter>
            <Sequence>
              <GetUIntFromList list="{room_sequence}"
                               index="0"
                               pop="false"
                               element="{room_number}"/>
              <GetRobotPose timeout="1"
                            error="{error}"
                            robot_pose="{robot_pose}"/>
              <PlanRoomExploration robot_pose="{robot_pose}"
                                   room_number="{room_number}"
                                   coverage_waypoints="{coverage_waypoints}"/>
            </Sequence>
          </Fallback>
          <SubTree ID="follow_waypoints"
                   waypoints="{coverage_waypoints}"/>
          <PopUIntFromList list="{room_sequence}"
                           element="{room_number}"/>
          <IsUIntListEmpty list="{room_sequence}"/>
        </Sequence>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>
</root>
