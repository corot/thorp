<root BTCPP_format="4">
    <TreeNodesModel>
        <Condition ID="AreSamePose">
            <input_port name="pose2" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;"/>
            <input_port name="pose1" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;"/>
            <input_port name="angle_tolerance" type="double"/>
            <input_port name="dist_tolerance" type="double"/>
        </Condition>
        <Condition ID="CameraFOVClear">
            <input_port name="timeout" type="unsigned int" default="100">timeout to connect to server (milliseconds)</input_port>
            <input_port name="service_name" type="std::string" default="xtion_fov_analyzer/check_clear">name of the ROS service</input_port>
        </Condition>
        <Action ID="ClearOctomap">
            <input_port name="timeout" type="unsigned int" default="100">timeout to connect to server (milliseconds)</input_port>
            <input_port name="service_name" type="std::string" default="clear_octomap">name of the ROS service</input_port>
        </Action>
        <Action ID="ClearPlanningScene">
            <input_port name="keep_tray" type="bool"/>
        </Action>
        <Action ID="ClearPoseList">
            <inout_port name="list" type="std::vector&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;"/>
        </Action>
        <Action ID="DetachObject">
            <input_port name="object_name" type="std::string"/>
        </Action>
        <Action ID="DetectObjects">
            <input_port name="object_types" type="std::string"/>
            <output_port name="objects" type="std::vector&lt;moveit_msgs::msg::CollisionObject_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;moveit_msgs::msg::CollisionObject_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;"/>
            <output_port name="surface" type="moveit_msgs::msg::CollisionObject_&lt;std::allocator&lt;void&gt; &gt;"/>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="DetectTables">
            <output_port name="table" type="moveit_msgs::msg::CollisionObject_&lt;std::allocator&lt;void&gt; &gt;"/>
            <output_port name="table_pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;"/>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="DragAndDrop">
            <output_port name="place_pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;"/>
            <output_port name="pickup_pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;"/>
            <output_port name="object_name" type="std::string"/>
            <input_port name="objects" type="std::vector&lt;moveit_msgs::msg::CollisionObject_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;moveit_msgs::msg::CollisionObject_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;"/>
        </Action>
        <Condition ID="FloatInBlackboard">
            <input_port name="key" type="float"/>
        </Condition>
        <Decorator ID="ForEachPickupLocation">
            <output_port name="element" type="thorp_msgs::msg::PickupLocation_&lt;std::allocator&lt;void&gt; &gt;"/>
            <inout_port name="list" type="std::vector&lt;thorp_msgs::msg::PickupLocation_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;thorp_msgs::msg::PickupLocation_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;"/>
        </Decorator>
        <Action ID="GetClosestPose">
            <output_port name="closest_pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;"/>
            <input_port name="target_pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;"/>
            <input_port name="poses" type="std::vector&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;"/>
        </Action>
        <Action ID="GetPoseListFront">
            <output_port name="element" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;"/>
            <input_port name="list" type="std::vector&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;"/>
        </Action>
        <Action ID="GetRobotPose">
            <output_port name="robot_pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;"/>
            <output_port name="error" type="int"/>
            <input_port name="timeout" type="double"/>
        </Action>
        <Action ID="GetUIntFromList">
            <output_port name="element" type="unsigned int"/>
            <inout_port name="list" type="std::vector&lt;unsigned int, std::allocator&lt;unsigned int&gt; &gt;"/>
            <input_port name="index" type="int" default="0">Index of the element to return; negative values count from the end</input_port>
            <input_port name="pop" type="bool" default="false">Remove the returned element</input_port>
        </Action>
        <Action ID="GripperBusy">
            <input_port name="closed_position" type="double" default="0.450000">gripper_joint angle fully closed</input_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Condition ID="IsBoolTrue">
            <input_port name="input" type="bool"/>
        </Condition>
        <Condition ID="IsPoseListEmpty">
            <input_port name="list" type="std::vector&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;"/>
        </Condition>
        <Condition ID="IsUIntListEmpty">
            <input_port name="list" type="std::vector&lt;unsigned int, std::allocator&lt;unsigned int&gt; &gt;"/>
        </Condition>
        <Action ID="MoveGripper">
            <input_port name="position" type="double" default="-0.360000">gripper_joint angle</input_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="NextPoseOnTray">
            <output_port name="pose_on_tray" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;"/>
        </Action>
        <Condition ID="ObjectAttached">
            <output_port name="attached_object" type="std::string"/>
        </Condition>
        <Condition ID="ObjectsDetected">
            <input_port name="ignore_given_up" type="bool"/>
            <input_port name="given_up_count" type="unsigned int"/>
            <input_port name="objects" type="std::vector&lt;moveit_msgs::msg::CollisionObject_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;moveit_msgs::msg::CollisionObject_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;"/>
        </Condition>
        <Action ID="PickupObject">
            <input_port name="object_name" type="std::string"/>
            <output_port name="feedback" type="std::optional&lt;thorp_msgs::action::PickupObject_Feedback_&lt;std::allocator&lt;void&gt; &gt; &gt;"/>
            <input_port name="support_surf" type="std::string"/>
            <input_port name="max_effort" type="float"/>
            <input_port name="tightening" type="float"/>
            <output_port name="error" type="int"/>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Condition ID="PickupPlanCompleted">
            <input_port name="list" type="std::vector&lt;thorp_msgs::msg::PickupLocation_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;thorp_msgs::msg::PickupLocation_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;"/>
        </Condition>
        <Action ID="PlaceObject">
            <input_port name="object_name" type="std::string"/>
            <output_port name="feedback" type="std::optional&lt;thorp_msgs::action::PlaceObject_Feedback_&lt;std::allocator&lt;void&gt; &gt; &gt;"/>
            <input_port name="support_surf" type="std::string"/>
            <input_port name="place_pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;"/>
            <output_port name="error" type="int"/>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="PopPoseFromList">
            <output_port name="element" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;"/>
            <inout_port name="list" type="std::vector&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;"/>
        </Action>
        <Action ID="PopUIntFromList">
            <output_port name="element" type="unsigned int"/>
            <inout_port name="list" type="std::vector&lt;unsigned int, std::allocator&lt;unsigned int&gt; &gt;"/>
        </Action>
        <Action ID="PoseAsPath">
            <output_port name="path" type="nav_msgs::msg::Path_&lt;std::allocator&lt;void&gt; &gt;"/>
            <input_port name="pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;"/>
        </Action>
        <Condition ID="PoseInBlackboard">
            <input_port name="key" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;"/>
        </Condition>
        <Action ID="PoseListSlicing">
            <input_port name="end" type="unsigned long"/>
            <input_port name="start" type="unsigned long"/>
            <inout_port name="list" type="std::vector&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;"/>
        </Action>
        <Action ID="PushPoseToList">
            <input_port name="element" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;"/>
            <inout_port name="list" type="std::vector&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;"/>
        </Action>
        <Action ID="ReadBoolParam">
            <output_port name="output_key" type="bool"/>
            <input_port name="param_name" type="std::string"/>
        </Action>
        <Action ID="ReadDoubleParam">
            <output_port name="output_key" type="double"/>
            <input_port name="param_name" type="std::string"/>
        </Action>
        <Action ID="ReadFloatParam">
            <output_port name="output_key" type="float"/>
            <input_port name="param_name" type="std::string"/>
        </Action>
        <Action ID="ReadIntParam">
            <output_port name="output_key" type="int"/>
            <input_port name="param_name" type="std::string"/>
        </Action>
        <Action ID="ReadStringParam">
            <output_port name="output_key" type="std::string"/>
            <input_port name="param_name" type="std::string"/>
        </Action>
        <Action ID="ReadUserCommands">
            <output_port name="user_command" type="std::string"/>
            <input_port name="valid_commands" type="std::vector&lt;std::__cxx11::basic_string&lt;char, std::char_traits&lt;char&gt;, std::allocator&lt;char&gt; &gt;, std::allocator&lt;std::__cxx11::basic_string&lt;char, std::char_traits&lt;char&gt;, std::allocator&lt;char&gt; &gt; &gt; &gt;">Commands the app supports, ';' separated</input_port>
        </Action>
        <Action ID="RecordPickupFailure">
            <inout_port name="given_up_count" type="unsigned int"/>
            <inout_port name="failures" type="std::map&lt;std::__cxx11::basic_string&lt;char, std::char_traits&lt;char&gt;, std::allocator&lt;char&gt; &gt;, unsigned int, std::less&lt;std::__cxx11::basic_string&lt;char, std::char_traits&lt;char&gt;, std::allocator&lt;char&gt; &gt; &gt;, std::allocator&lt;std::pair&lt;std::__cxx11::basic_string&lt;char, std::char_traits&lt;char&gt;, std::allocator&lt;char&gt; &gt; const, unsigned int&gt; &gt; &gt;"/>
            <input_port name="target_name" type="std::string"/>
        </Action>
        <Control ID="RecoverAndRetry"/>
        <Action ID="SelectNextTarget">
            <output_port name="tightening" type="float"/>
            <output_port name="target_name" type="std::string"/>
            <input_port name="failures" type="std::map&lt;std::__cxx11::basic_string&lt;char, std::char_traits&lt;char&gt;, std::allocator&lt;char&gt; &gt;, unsigned int, std::less&lt;std::__cxx11::basic_string&lt;char, std::char_traits&lt;char&gt;, std::allocator&lt;char&gt; &gt; &gt;, std::allocator&lt;std::pair&lt;std::__cxx11::basic_string&lt;char, std::char_traits&lt;char&gt;, std::allocator&lt;char&gt; &gt; const, unsigned int&gt; &gt; &gt;"/>
            <input_port name="objects" type="std::vector&lt;moveit_msgs::msg::CollisionObject_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;moveit_msgs::msg::CollisionObject_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;"/>
        </Action>
        <Action ID="SetArmConfig">
            <input_port name="configuration" type="std::string"/>
            <output_port name="error" type="int"/>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="SetBool">
            <output_port name="output" type="bool"/>
            <input_port name="input" type="bool"/>
        </Action>
        <Action ID="SetDouble">
            <output_port name="output" type="double"/>
            <input_port name="input" type="double"/>
        </Action>
        <Action ID="SetPose">
            <output_port name="output" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;"/>
            <input_port name="input" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;"/>
        </Action>
        <Action ID="SetString">
            <output_port name="output" type="std::string"/>
            <input_port name="input" type="std::string"/>
        </Action>
        <Action ID="SetUInt">
            <output_port name="output" type="unsigned int"/>
            <input_port name="input" type="unsigned int"/>
        </Action>
        <Decorator ID="StoreResult">
            <output_port name="result" type="bool"/>
        </Decorator>
        <Condition ID="TableValidSize">
            <input_port name="table" type="moveit_msgs::msg::CollisionObject_&lt;std::allocator&lt;void&gt; &gt;"/>
        </Condition>
        <Action ID="TrackProgress">
            <output_port name="next_waypoint" type="unsigned long"/>
            <inout_port name="waypoints" type="std::vector&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;, std::allocator&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt; &gt; &gt;"/>
            <input_port name="reached_threshold" type="double"/>
            <input_port name="robot_pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;"/>
        </Action>
        <Action ID="TransformPose">
            <output_port name="out_pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;"/>
            <input_port name="yaw" type="double"/>
            <input_port name="pitch" type="double"/>
            <input_port name="in_pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;"/>
            <input_port name="roll" type="double"/>
            <input_port name="z" type="double"/>
            <input_port name="y" type="double"/>
            <input_port name="local" type="bool" default="false">apply the offset along in_pose's own axes, not its frame's</input_port>
            <input_port name="x" type="double"/>
        </Action>
        <Condition ID="TrayFull"/>
    </TreeNodesModel>
</root>

