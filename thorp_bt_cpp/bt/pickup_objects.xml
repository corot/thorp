<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <include path="manipulation.xml"/>

  <BehaviorTree ID="pickup_objects">
    <Fallback>
      <Sequence>
        <Script code="already_detected:=false"/>
        <KeepRunningUntilFailure>
          <RecoverAndRetry>
            <Sequence>
              <Inverter>
                <TrayFull/>
              </Inverter>
              <DetectObjects surface="{surface}"
                             objects="{objects}"
                             object_types=""
                             _skipIf="already_detected"/>
              <ObjectsDetected objects="{objects}"/>
              <SelectNextTarget tightening="{tightening}"
                                failures="{failures}"
                                target_name="{object_name}"
                                objects="{objects}"/>
              <IfThenElse>
                <SubTree ID="pickup_object"
                         object_name="{object_name}"
                         tightening="{tightening}"
                         error="{error}"
                         _post="already_detected=false"/>
                <Parallel failure_count="1"
                          success_count="2">
                  <SubTree ID="place_on_tray"
                           object_name="{object_name}"
                           error="{error}"/>
                  <RetryUntilSuccessful num_attempts="-1"
                                        _skipIf="already_detected">
                    <Sequence>
                      <Fallback>
                        <CameraFOVClear timeout="100"
                                        service_name="xtion_fov_analyzer/check_clear"/>
                        <Sleep msec="100"/>
                      </Fallback>
                      <DetectObjects surface="{surface}"
                                     objects="{objects}"
                                     object_types=""
                                     _onSuccess="already_detected=true"/>
                    </Sequence>
                  </RetryUntilSuccessful>
                </Parallel>
                <RecordPickupFailure given_up_count="{given_up_count}"
                                     failures="{failures}"
                                     target_name="{object_name}"/>
              </IfThenElse>
            </Sequence>
            <SubTree ID="stow_arm"
                     error="{error}"
                     _post="already_detected=false"/>
          </RecoverAndRetry>
        </KeepRunningUntilFailure>
      </Sequence>
      <Inverter _description="To report FAILURE only if we still have reachable targets or tray is full">
        <Sequence>
          <SelectNextTarget tightening="{tightening}"
                            failures="{failures}"
                            target_name="{object_name}"
                            objects="{objects}"/>
          <TrayFull/>
        </Sequence>
      </Inverter>
    </Fallback>
  </BehaviorTree>
</root>
