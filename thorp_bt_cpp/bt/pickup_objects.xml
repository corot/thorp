<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="3">
  <include path="manipulation.xml"/>

  <BehaviorTree ID="pickup_objects">
    <Fallback>
      <KeepRunningUntilFailure>
        <RecoverAndRetry>
          <Sequence>
            <Inverter>
              <TrayFull service_name="manipulation/tray/get_capacity"
                        timeout="100"/>
            </Inverter>
            <DetectObjects action_name="object_detection"
                           object_types=""
                           server_timeout="5.000000"
                           objects="{objects}"
                           surface="{surface}"/>
            <ObjectsDetected given_up_count=""
                             ignore_given_up=""
                             objects="{objects}"/>
            <SelectNextTarget failures="{failures}"
                              objects="{objects}"
                              target_name="{object_name}"
                              tightening="{tightening}"/>
            <IfThenElse>
              <SubTree ID="pickup_object"/>
              <SubTree ID="place_on_tray"
                       tray_full="{tray_full}"/>
              <RecordPickupFailure target_name="{object_name}"
                                   failures="{failures}"
                                   given_up_count="{given_up_count}"/>
            </IfThenElse>
          </Sequence>
          <SetArmConfig action_name="move_to_target"
                        configuration="resting"
                        server_timeout="5.000000"
                        error="{error}"
                        feedback=""/>
        </RecoverAndRetry>
      </KeepRunningUntilFailure>
      <Inverter _description="To report FAILURE only if we still have reachable targets or tray is full">
        <Sequence>
          <TrayFull service_name="manipulation/tray/get_capacity"
                    timeout="100"/>
          <SelectNextTarget failures="{failures}"
                            objects="{objects}"
                            target_name="{object_name}"
                            tightening="{tightening}"/>
        </Sequence>
      </Inverter>
    </Fallback>
  </BehaviorTree>
</root>
