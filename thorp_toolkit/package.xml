<?xml version="1.0"?>
<package format="2">
  <name>thorp_toolkit</name>
  <version>0.1.0</version>
  <description>Package containing convenience nodes and libs for Thorp robot</description>
  <maintainer email="jsantossimon@gmail.com">Jorge Santos Simón</maintainer>
  <author email="jsantossimon@gmail.com">Jorge Santos Simón</author> 

  <license>BSD</license>

  <url type="bugtracker">https://github.com/corot/thorp/issues</url>
  <url type="repository">https://github.com/corot/thorp</url>
  <url type="website">http://wiki.ros.org/thorp_toolkit</url> 

  <buildtool_depend>catkin</buildtool_depend>

  <depend>tf</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>roscpp</depend>
  <depend>angles</depend>
  <depend>geometry_msgs</depend>
  <depend>geometric_shapes</depend>
  <depend>kobuki_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>dynamic_reconfigure</depend>
  <depend>eigen_conversions</depend>
  <depend>thorp_msgs</depend>

  <exec_depend>jsk_rviz_plugins</exec_depend>
</package>
