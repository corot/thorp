# Source dependencies with no Lyrical release, pinned to a commit unless they are Thorp's own forks; import them into
# src/third_party:
#   vcs import ../third_party < thorp-lyrical.repos
repositories:
  # YOLO object detection, 3D and tracking, for the cat hunter's detector; its build creates its own Python virtual
  # environment with uv, if installed, for Ultralytics and PyTorch. Thorp's fork, of the last Python version, requiring
  # numpy 2 as Lyrical's ROS Python modules, which the environment shares, are built against it
  yolo_ros:
    type: git
    url: https://github.com/corot/yolo_ros.git
    version: lyrical
  # The small house Gazebo world and its map, ported to Gazebo Harmonic; Thorp's fork, so it follows its branch
  aws_robomaker_small_house_world:
    type: git
    url: https://github.com/corot/aws-robomaker-small-warehouse-world.git
    version: ros2
